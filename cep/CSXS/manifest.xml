<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   Version="7.0"
                   ExtensionBundleId="com.mcp.premiere.bridge"
                   ExtensionBundleName="MCP Bridge"
                   ExtensionBundleVersion="2.0.0">

  <ExtensionList>
    <Extension Id="com.mcp.premiere.bridge.panel" Version="2.0.0" />
    <Extension Id="com.mcp.premiere.bridge.service" Version="2.0.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <!-- Status panel (Window > Extensions > MCP Bridge). UI only; safe to close. -->
    <Extension Id="com.mcp.premiere.bridge.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>MCP Bridge</Menu>
          <Geometry>
            <Size>
              <Height>240</Height>
              <Width>320</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>

    <!-- Hidden bridge service: starts with Premiere, owns 127.0.0.1:8097, runs ExtendScript for all MCP clients. -->
    <Extension Id="com.mcp.premiere.bridge.service">
      <DispatchInfo>
        <Resources>
          <MainPath>./service.html</MainPath>
          <ScriptPath>./jsx/premiere.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Height>1</Height>
              <Width>1</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>

</ExtensionManifest>
